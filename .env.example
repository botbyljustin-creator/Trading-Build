# US100 COMMAND — environment configuration
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up --build`. Never commit `.env` — it is gitignored.
# Variables for phases not yet implemented are present but currently
# inert; leaving them blank is safe and expected until that phase lands.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Postgres (used by the `postgres` container and by the backend's
# DATABASE_URL below — keep the credentials in sync if you change them)
# ---------------------------------------------------------------------------
POSTGRES_USER=us100
POSTGRES_PASSWORD=us100_dev_password_change_me
POSTGRES_DB=us100_command
POSTGRES_PORT=5432

# Docker Compose default: host "postgres" resolves inside the compose
# network. Running the backend outside Docker instead? Use "localhost".
DATABASE_URL=postgresql+psycopg://us100:us100_dev_password_change_me@postgres:5432/us100_command

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-random-secret

# ---------------------------------------------------------------------------
# TradingView webhook (Phase 2) — shared secret validated on every inbound
# POST /api/webhooks/tradingview payload. Leave blank to keep the webhook
# endpoint disabled until you're ready to use it.
# ---------------------------------------------------------------------------
TRADINGVIEW_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Anthropic Claude (Phase 8) — advisory AI analysis only, never used for
# position sizing, stops, or any deterministic financial calculation.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Telegram alerts (Phase 7)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Email notifications (interface defined in V1; SMTP implementation deferred)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Live trading safety gate — see docs/LIVE_TRADING_FUTURE.md.
# Must stay "false" for V1. Flipping this alone does NOT enable live
# execution; it is one of several required conditions.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------------------
# Ports / frontend wiring
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Browser-facing backend URL (used by Client Components).
NEXT_PUBLIC_API_URL=http://localhost:8000
