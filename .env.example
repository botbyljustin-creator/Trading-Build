# StrategyForge AI — environment configuration
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up --build`. Never commit `.env` — it is gitignored.
# Leaving a variable blank disables the feature it configures rather than
# crashing the app (e.g. no LLM key -> extraction endpoints return a clear
# "not configured" error instead of a fake result).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Postgres (used by the `postgres` container and by the backend's
# DATABASE_URL below — keep the credentials in sync if you change them).
# The `pgvector/pgvector:pg16` image ships the pgvector extension needed
# for transcript-chunk embeddings; the initial Alembic migration creates it.
# ---------------------------------------------------------------------------
POSTGRES_USER=strategyforge
POSTGRES_PASSWORD=strategyforge_dev_password_change_me
POSTGRES_DB=strategyforge
POSTGRES_PORT=5432

# Docker Compose default: host "postgres" resolves inside the compose
# network. Running the backend outside Docker instead? Use "localhost".
DATABASE_URL=postgresql+psycopg://strategyforge:strategyforge_dev_password_change_me@postgres:5432/strategyforge

# ---------------------------------------------------------------------------
# Redis (Celery broker/result backend)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-random-secret

# ---------------------------------------------------------------------------
# Clerk (authentication) — https://dashboard.clerk.com
# Leave all three blank + AUTH_DEV_MODE=true to run locally without Clerk,
# authenticated as a single fixed dev user (see README.md). Never set
# AUTH_DEV_MODE=true in a deployed environment.
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# JWKS URL for your Clerk instance, e.g. https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_ISSUER=
AUTH_DEV_MODE=true

# Frontend needs the publishable key too (browser-exposed by design — it is
# not a secret). Must match CLERK_PUBLISHABLE_KEY above when set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# LLM providers — set at least one to use extraction/analysis features.
# Never hardcoded to one provider; DEFAULT_LLM_PROVIDER picks which is used
# when an agent doesn't specify one explicitly.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEFAULT_LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Cost controls — see docs/AI_PIPELINE.md
# ---------------------------------------------------------------------------
LARGE_JOB_COST_CONFIRMATION_THRESHOLD_USD=2.0
MAX_VIDEOS_PER_CHANNEL_INGEST=500

# ---------------------------------------------------------------------------
# Market data — CSV is the only provider implemented in V1. Point this at a
# directory containing "<symbol>.csv" (timestamp,open,high,low,close,volume)
# and "<symbol>.meta.json" ({"timezone":...,"asset_type":...}) files. See
# docs/BACKTESTING.md.
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=csv
MARKET_DATA_CSV_DIR=/app/data/market_csv

# ---------------------------------------------------------------------------
# Stripe (billing) — NOT IMPLEMENTED in this build (no webhook handler, no
# subscription table, no plan-gating). Reserved for when that's built.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Ports / frontend wiring
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Browser-facing backend URL (used by Client Components).
NEXT_PUBLIC_API_URL=http://localhost:8000
